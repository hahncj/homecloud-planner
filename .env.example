POSTGRES_DB=homecloud
POSTGRES_USER=homecloud
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/homecloud
SPRING_DATASOURCE_USERNAME=homecloud
SPRING_DATASOURCE_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Sole administrator account, created once at first startup (see ADR-0008).
# If left unset, the app still starts but login will not work until you set
# these and restart. Change these before first startup on a real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to true only when the app is served over HTTPS (see docs/security.md).
SESSION_COOKIE_SECURE=false
